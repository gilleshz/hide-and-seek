# Copy to .env and edit the few values that need changing.
# Never commit .env.
#
# The only value you MUST set:
OVERPASS_MIRRORS=https://overpass-api.de/api/interpreter,https://overpass.osm.ch/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.kumi.systems/api/interpreter
OVERPASS_MIRRORS_RANDOMIZE=true

# Leave blank: generated at first boot and persisted in the secrets volume.
# APP_API_KEY must then be copied into the Android app (see deploy/README.md).
APP_SECRET=
APP_API_KEY=
MERCURE_PUBLISHER_JWT_KEY=
MERCURE_SUBSCRIBER_JWT_KEY=
# MERCURE_JWT_SECRET=   # deprecated legacy alias (seeds both keys); do not set it

# Map tile API keys (optional, leave blank to disable those styles):
STADIA_API_KEY=
THUNDERFOREST_API_KEY=
MAPTILER_API_KEY=

# Tuning knobs (optional, defaults are fine for most):
TRANSIT_MAX_RESPONSE_BYTES=33554432
MAX_BOUNDARY_SPAN_DEG=4.0
CHAT_IMAGE_DIR=/app/var/uploads

# Host port (change if 80 is in use):
HTTP_PORT=80
