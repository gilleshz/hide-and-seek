# EditorConfig, shared formatting, honored by Android Studio and ktlint.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
# ktlint rules (ktlint reads ktlint_* keys from here).
max_line_length = 120
ktlint_standard_function-naming = disabled
ktlint_function_signature_body_expression_wrapping = default

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
