<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Base application theme. Jetpack Compose draws the actual UI (colors, typography)
        via its own MaterialTheme in Theme.kt; this XML theme only needs to give the
        Activity a sane window background and no action bar before Compose takes over.
    -->
    <style name="Theme.HideAndSeek" parent="Theme.AppCompat.DayNight.NoActionBar" />
</resources>
